@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #2e6b4f
skinparam linetype ortho
skinparam class {
  BackgroundColor #f5faf6
  BorderColor #1e4a35
  HeaderBackgroundColor #e2efe6
}
hide circle
hide empty methods
title Modelo entidad-relación (PostgreSQL y Oracle)
legend bottom left
  Línea punteada: ENTRADA, SALIDA y DETALLE_VENTA guardan PRODUCTO_ID
  sin llave foránea (es historial y se conserva si el producto se borra).
endlegend

entity "PERFIL" as PERFIL {
  * ID <<PK>>
  --
  * NOMBRE
  DESCRIPCION
  COLOR
  TIPO_NEGOCIO
  FECHA_CREACION
}
entity "PERFIL_CONFIGURACION" as CONF {
  * PERFIL_ID <<PK, FK>>
  * CLAVE <<PK>>
  --
  VALOR
}
entity "CATEGORIA" as CAT {
  * PERFIL_ID <<PK, FK>>
  * ID <<PK>>
  --
  * NOMBRE
  DESCRIPCION
}
entity "PROVEEDOR" as PROV {
  * PERFIL_ID <<PK, FK>>
  * ID <<PK>>
  --
  * NOMBRE
  CONTACTO, TELEFONO, EMAIL
  DIRECCION, CATEGORIA
  * ACTIVO
}
entity "PRODUCTO" as PROD {
  * PERFIL_ID <<PK, FK>>
  * ID <<PK>>
  --
  * NOMBRE
  CODIGO, DESCRIPCION, CATEGORIA
  CATEGORIA_ID <<FK>>
  PROVEEDOR_ID <<FK>>
  * PRECIO_COMPRA, * PRECIO_VENTA
  * STOCK, * STOCK_MIN
  TIPO, * REQUIERE_VENCIMIENTO
  FECHA_VENCIMIENTO, FECHA_MODIFICACION
}
entity "ENTRADA" as ENT {
  * PERFIL_ID <<PK, FK>>
  * ID <<PK>>
  --
  * PRODUCTO_ID
  * CANTIDAD
  FECHA, PROVEEDOR_ID
  * PRECIO_UNITARIO, OBSERVACION
}
entity "SALIDA" as SAL {
  * PERFIL_ID <<PK, FK>>
  * ID <<PK>>
  --
  * PRODUCTO_ID
  * CANTIDAD
  FECHA, MOTIVO, TIPO
}
entity "VENTA" as VEN {
  * PERFIL_ID <<PK, FK>>
  * ID <<PK>>
  --
  CLIENTE, METODO_PAGO
  OBSERVACION, REFERENCIA_PAGO
  FECHA, ESTADO, * TOTAL
}
entity "DETALLE_VENTA" as DET {
  * PERFIL_ID <<PK, FK>>
  * VENTA_ID <<PK, FK>>
  * LINEA <<PK>>
  --
  * PRODUCTO_ID, NOMBRE_PRODUCTO
  * CANTIDAD, * PRECIO_UNITARIO
  * SUBTOTAL, * COSTO_UNITARIO
}
entity "HISTORIAL_PRECIO" as HIS {
  * ID <<PK>> (identidad)
  --
  * PERFIL_ID <<FK>>
  * PRODUCTO_ID
  PRECIO_COMPRA_ANTERIOR, PRECIO_COMPRA_NUEVO
  PRECIO_VENTA_ANTERIOR, PRECIO_VENTA_NUEVO
  * FECHA_CAMBIO, USUARIO_BD
}

PERFIL ||--o{ CONF
PERFIL ||--o{ CAT
PERFIL ||--o{ PROV
PERFIL ||--o{ PROD
PERFIL ||--o{ ENT
PERFIL ||--o{ SAL
PERFIL ||--o{ VEN
PERFIL ||--o{ HIS
CAT |o--o{ PROD
PROV |o--o{ PROD
VEN ||--|{ DET
PROD ..o{ ENT
PROD ..o{ SAL
PROD ..o{ DET : historial\n(sin FK)
PROD ..o{ HIS : disparador\nTRG_PRODUCTO_HISTORIAL_PRECIO
@enduml
