@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #2e6b4f
skinparam class {
  BackgroundColor #f5faf6
  BorderColor #1e4a35
  HeaderBackgroundColor #e2efe6
}
skinparam package {
  BorderColor #1e4a35
  FontColor #14281d
}
hide empty members

title Diagrama de clases — ventanas, cámaras y utilidades (view, dispositivo, util) — TBalance v3.5.0

package dispositivo {
interface Camera {
  + {abstract} abrir()
  + {abstract} capturar() : BufferedImage
  + {abstract} cerrar()
  + avisar()
}
interface CameraProvider {
  + {abstract} listar() : List<String>
  + {abstract} crear() : Camera
}
class PhoneCamera {
  - enlace : PhoneLink
  + abrir()
  + capturar() : BufferedImage
  + cerrar()
  + avisar()
}
class PhoneLink {
  - carpeta : Path
  - servidor : HttpsServer
  - clave : String
  - direccion : String
  - ultimaFoto : byte[]
  - fotoNueva : boolean
  - ultimaFotoMs : long
  - avisos : List<String>
  + iniciar() : String
  + detener()
  + prepararCertificado()
  + estaActivo() : boolean
  + celularConectado() : boolean
  + tomarFotoNueva() : BufferedImage
  + avisar()
  + {static} direccionLocal() : Optional<String>
}
class WebcamCamera {
  - nombre : String
  - webcam : Webcam
  + {static} disponibles() : List<String>
  + abrir()
  + capturar() : BufferedImage
  + cerrar()
}
}
package util {
class DateUtil {
  + {static} hoy() : String
  + {static} ahora() : String
  + {static} parsear() : Optional<LocalDate>
  + {static} formatearFecha() : String
  + {static} parsearMomento() : Optional<LocalDateTime>
}
class FileUtil {
  + {static} carpetaTemporal() : Path
  + {static} borrarCarpeta()
  + {static} copiarCarpeta()
}
class IdGenerator {
  + {static} conPrefijo() : String
  + {static} siguienteNumerico() : String
}
class ImageEncoder {
  + {static} aJpegDataUri() : String
  + {static} aPngDataUri() : String
}
class JsonUtil {
  + {static} toJsonCompacto() : String
  + {static} toJson() : String
  + {static} fromJson() : T
  + {static} fromJsonList() : List<T>
  + {static} getGson() : Gson
}
class PasswordHasher {
  + {static} resumir() : String
  + {static} coincide() : boolean
}
class QrGenerator {
  + generar() : BufferedImage
}
class QrReader {
  - pistas : Map<DecodeHintType, Object>
  + leer() : Optional<String>
}
class TextUtil {
  + {static} esVacio() : boolean
  + {static} contieneIgnorandoMayusculas() : boolean
  + {static} normalizar() : String
  + {static} recortar() : String
}
}
package view {
class BrowserWindow {
  - carpetaPerfil : Path
  - proceso : Process
  + {static} buscarNavegador() : Optional<String>
  + abrir()
  + cerrar()
}
class DesktopBrowserApp {
  + {static} iniciar() : boolean
}
class LocalWebServer {
  - invocador : BridgeInvoker
  - notificador : SseNotifier
  - clave : String
  - servidor : HttpServer
  - hilos : ExecutorService
  + iniciar() : String
  + detener()
}
class SnapshotTransition {
  - raiz : StackPane
  - vista : WebView
  + desvanecerZona()
}
class WebViewBridgeAdapter {
  - invocador : BridgeInvoker
  + llamar() : String
}
class WebViewMain {
  - contexto : AppContext
  - motor : WebEngine
  - webView : WebView
  - raiz : StackPane
  - bridge : JavaBridge
  - puenteJs : WebViewBridgeAdapter
  + show()
  + actualizarTitulo()
}
class WindowsTaskbarIcon {
  + {static} aplicar()
}
}
interface ScreenTransition <<otro diagrama>>
Camera <|.. PhoneCamera
Camera <|.. WebcamCamera
PhoneCamera --> PhoneLink
ScreenTransition <|.. SnapshotTransition
WebViewMain --> WebViewBridgeAdapter
@enduml
