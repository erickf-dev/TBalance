@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #2e6b4f
skinparam class {
  BackgroundColor #f5faf6
  BorderColor #1e4a35
  HeaderBackgroundColor #e2efe6
}
skinparam package {
  BorderColor #1e4a35
  FontColor #14281d
}
hide empty members

title Diagrama de clases — informes y asistente (service, ia, model, repository) — TBalance v3.5.0

package exception {
class AssistantException {
}
}
package ia {
class GeminiClient {
  - clave : String
  - modelo : String
  - http : HttpClient
  - alCambiarModelo : Consumer<String>
  + modelo() : String
  + alCambiarModelo()
  + generar() : ModelReply
  + buscarModeloDisponible() : Optional<String>
  + {static} elegirModelo() : Optional<String>
  + {static} textoComoContenido() : JsonObject
}
interface LanguageModel {
  + {abstract} generar() : ModelReply
}
class SecureConnection {
  + {static} crearCliente() : HttpClient
}
}
package model {
class AssistantSettings <<record>> {
}
class SalesReport <<record>> {
}
}
package repository {
class AssistantConfigRepository {
  - archivo : Path
  + leer() : Optional<AssistantSettings>
  + guardar()
  + borrar()
}
class ReportExcelWriter {
  + escribir()
}
}
package service {
class AssistantProposal {
  - id : String
  - tipo : String
  - titulo : String
  - lineas : List<String>
  - total : Double
  - accion : Runnable
  + ejecutar()
}
class AssistantService {
  - modelo : LanguageModel
  - servicios : Supplier<ProfileServices>
  - perfil : Supplier<Profile>
  - hiloDeDatos : Executor
  - permisos : Supplier<Set<Permiso>>
  - historial : List<JsonObject>
  - pendientes : Map<String, AssistantProposal>
  - notas : List<String>
  + conversar() : Reply
  + confirmar() : String
  + descartar()
  + reiniciar()
  + {static} loQuePuedeHacer() : String
}
class AssistantSettingsService {
  - repositorio : AssistantConfigRepository
  + leer() : Optional<AssistantSettings>
  + modeloActual() : String
  + configurar()
  + requerir() : AssistantSettings
  + crearModelo() : LanguageModel
  + probarConexion() : ConnectionTest
  + probarClave() : ConnectionTest
}
class AssistantTools {
  - servicios : ProfileServices
  - permisos : Set<Permiso>
  - alProponer : Consumer<AssistantProposal>
  - contador : int
  + {static} permisoParaConfirmar() : Permiso
  + {static} declaraciones() : JsonArray
  + ejecutar() : JsonObject
  + {static} normalizar() : String
  + {static} dinero() : String
}
class ReportExportService {
  - excel : ReportExcelWriter
  - carpeta : Path
  + exportarExcel() : Path
  + {static} carpetaPorDefecto() : Path
}
class ReportService {
  - ventas : SaleService
  - inventario : InventoryService
  + generar() : SalesReport
}
}
package util {
class AssistantLog {
  + {static} registrar()
  + {static} archivo() : Path
}
}
AssistantService --> LanguageModel
AssistantService o-- AssistantProposal
AssistantSettingsService --> AssistantConfigRepository
AssistantTools --> AssistantProposal
LanguageModel <|.. GeminiClient
ReportExportService --> ReportExcelWriter
@enduml
