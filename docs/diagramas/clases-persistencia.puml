@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #2e6b4f
skinparam class {
  BackgroundColor #f5faf6
  BorderColor #1e4a35
  HeaderBackgroundColor #e2efe6
}
skinparam package {
  BorderColor #1e4a35
  FontColor #14281d
}
hide empty members

title Diagrama de clases — contenido de las copias de seguridad (repository) — TBalance v3.5.0

package repository {
interface BackupStore {
  + {abstract} listar() : List<Backup>
  + {abstract} existe() : boolean
  + {abstract} guardar() : Backup
  + {abstract} leer()
  + {abstract} eliminar()
  + {abstract} ubicacion() : String
  + {abstract} carpeta() : Path
}
class GlobalConfigRepository {
  - almacen : JsonFileStore
  + existe() : boolean
  + cargar() : GlobalConfig
  + guardar()
}
class JsonFileStore {
  - archivo : Path
  + existe() : boolean
  + leer() : Optional<String>
  + escribir()
  + {static} crearDirectorio()
}
class JsonRepository {
  - almacen : JsonFileStore
  - tipo : Class<T>
  - cache : List<T>
  + listarTodos() : List<T>
  + buscarPorId() : Optional<T>
  + existe() : boolean
  + filtrar() : List<T>
  + agregar()
  + actualizar() : boolean
  + eliminar() : boolean
  + siguienteIdNumerico() : String
  + getArchivo() : Path
}
class JsonStorageProvider {
  - carpeta : Path
  + nombre() : String
  + perfiles() : Repository<Profile>
  + usuarios() : Repository<User>
  + auditoria() : Repository<AuditEntry>
  + productos() : Repository<Product>
  + categorias() : Repository<Category>
  + proveedores() : Repository<Supplier>
  + entradas() : Repository<StockEntry>
  + abonos() : Repository<CreditPayment>
  + ... (2 más)
}
class LabelRepository {
  - carpeta : Path
  + guardar() : Path
  + aDataUri() : String
}
class PaymentQrRepository {
  - carpeta : Path
  + guardar()
  + leerComoDataUrl() : Optional<String>
  + eliminar()
}
interface Repository {
  + {abstract} listarTodos() : List<T>
  + {abstract} buscarPorId() : Optional<T>
  + {abstract} existe() : boolean
  + {abstract} filtrar() : List<T>
  + {abstract} agregar()
  + {abstract} actualizar() : boolean
  + {abstract} eliminar() : boolean
  + {abstract} siguienteIdNumerico() : String
  + refrescar()
}
class ZipArchiver {
  + comprimir()
  + extraer() : int
}
}
interface StorageProvider <<otro diagrama>>
GlobalConfigRepository --> JsonFileStore
JsonRepository --> JsonFileStore
Repository <|.. JsonRepository
StorageProvider <|.. JsonStorageProvider
@enduml
