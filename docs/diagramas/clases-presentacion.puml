@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #2e6b4f
skinparam class {
  BackgroundColor #f5faf6
  BorderColor #1e4a35
  HeaderBackgroundColor #e2efe6
}
skinparam package {
  BorderColor #1e4a35
  FontColor #14281d
}
skinparam note {
  BackgroundColor #fdf8ea
  BorderColor #d4a72c
}
hide empty members

title Diagrama de clases — paquetes bridge y dispositivo
package sistemainventario {
class AppContext
}
package bridge {
class JavaBridge {
  - perfiles : ProfileController
  - inventario : InventoryController
  - catalogo : CatalogController
  - transacciones : TransactionController
  - respaldos : BackupController
  - etiquetas : LabelController
  - informes : ReportController
  - asistente : AssistantController
  - escaneo : ScanController
  - notificador : ViewNotifier
  - transicion : ScreenTransition
  + transicionPantalla(x : double, y : double, ancho : double, alto : double, milisegundos : int) : String
  + obtenerInforme(desde : String, hasta : String, anteriorDesde : String, anteriorHasta : String) : String
  + exportarInformeExcel(desde : String, hasta : String, anteriorDesde : String, anteriorHasta : String) : String
  + asistenteEstado() : String
  + asistenteConfigurar(clave : String, modelo : String) : String
  + asistenteEnviar(mensaje : String) : String
  .. 45 métodos más que delegan ..
}
